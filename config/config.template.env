# Vltimate CV Scraper - Default Configuration Template
# Copy this file to './config/vltimate_config.env' and fill in your values.
# The actual config file is never tracked in git.

CLOUD_SYNC_ENABLED="false"
GITHUB_USER=""
GITHUB_TOKEN=""
VAULT_REPO="vltimate-cv-vault"
PUBLIC_REPO="vltimate-cv-scraper"
